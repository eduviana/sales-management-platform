// Royal Prestige — Plataforma de Gestión de Ventas
// Schema Prisma derivado del modelo físico aprobado.
// Fuente de verdad: docs/database/data-model.md v0.6
// PostgreSQL como base de datos relacional principal (ADR-008).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Enums
// =============================================================================

enum EmployeeStatus {
  ACTIVE
  INACTIVE

  @@map("employee_status")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  LOCKED

  @@map("account_status")
}

enum SaleStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  CANCELLED

  @@map("sale_status")
}

enum CommissionType {
  EARNED
  REVERSAL
  ADJUSTMENT

  @@map("commission_type")
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED

  @@map("audit_result")
}

enum AuditAction {
  // Identity
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED

  // Organization
  EMPLOYEE_CREATED
  EMPLOYEE_UPDATED
  EMPLOYEE_DEACTIVATED
  EMPLOYEE_LEVEL_CHANGED
  EMPLOYEE_SUPERVISOR_CHANGED

  // Sales
  SALE_CREATED
  SALE_UPDATED
  SALE_SUBMITTED
  SALE_APPROVED
  SALE_REJECTED
  SALE_CANCELLED

  // Commissions
  COMMISSION_RULE_CREATED
  COMMISSION_GENERATED
  COMMISSION_REVERSED

  @@map("audit_action")
}

enum ContentType {
  PDF
  VIDEO
  DOCUMENT
  LINK

  @@map("content_type")
}

enum ProgressType {
  SENIORITY
  VISIT
  SALE
  TARGET_ACHIEVED

  @@map("progress_type")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("content_status")
}

// =============================================================================
// Level
// =============================================================================

model Level {
  id   Int    @id @default(autoincrement())
  code String @unique @db.VarChar(20)
  rank Int    @unique
  name String @db.VarChar(100)

  employees            Employee[]
  employeeLevelHistory EmployeeLevelHistory[]
  commissionRules      CommissionRule[]
  trainingMaterials    TrainingMaterial[]
  monthlyTargets       MonthlyTarget[]

  @@map("level")
}

// =============================================================================
// Employee
// =============================================================================

model Employee {
  id                 String         @id @default(uuid()) @db.Uuid
  employeeCode       Int            @unique @default(autoincrement())
  firstName          String         @db.VarChar(100)
  lastName           String         @db.VarChar(100)
  dni                String?        @unique @db.VarChar(20)
  email              String?        @unique @db.VarChar(255)
  phone              String?        @db.VarChar(50)
  dateOfBirth        DateTime?      @db.Date
  joinedAt           DateTime       @db.Date
  currentLevelId     Int?
  supervisorId       String?        @db.Uuid
  status             EmployeeStatus @default(ACTIVE)
  deactivatedAt      DateTime?
  deactivationReason String?        @db.Text
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Dirección
  street             String?        @db.VarChar(200)
  streetNumber       String?        @db.VarChar(20)
  floor              String?        @db.VarChar(20)
  apartment          String?        @db.VarChar(20)
  city               String?        @db.VarChar(100)
  province           String?        @db.VarChar(100)
  postalCode         String?        @db.VarChar(20)

  // Relaciones
  currentLevel              Level?                      @relation(fields: [currentLevelId], references: [id])
  supervisor                Employee?                   @relation("SupervisorHierarchy", fields: [supervisorId], references: [id])
  subordinates              Employee[]                  @relation("SupervisorHierarchy")
  userAccount               UserAccount?
  employeeLevelHistory      EmployeeLevelHistory[]
  employeeSupervisorHistory EmployeeSupervisorHistory[]
  supervisorHistoryRecords  EmployeeSupervisorHistory[] @relation("SupervisorHistoryTarget")
  sales                     Sale[]
  commissionEntries         CommissionEntry[]
  ownedClients              Client[]                    @relation("ClientOwner")
  visitsAsSeller            Visit[]                     @relation("VisitSeller")
  visitsAsAssignedBy        Visit[]                     @relation("VisitAssignedBy")
  progressEntries           EmployeeProgress[]

  @@index([currentLevelId])
  @@index([supervisorId])
  @@index([status])
  @@map("employee")
}

// =============================================================================
// EmployeeLevelHistory
// =============================================================================

model EmployeeLevelHistory {
  id         String    @id @default(uuid()) @db.Uuid
  employeeId String    @db.Uuid
  levelId    Int
  startedAt  DateTime
  endedAt    DateTime?
  reason     String?   @db.Text
  createdAt  DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
  level    Level    @relation(fields: [levelId], references: [id])

  @@index([employeeId])
  @@index([levelId])
  @@index([startedAt])
  @@map("employee_level_history")
}

// =============================================================================
// EmployeeSupervisorHistory
// =============================================================================

model EmployeeSupervisorHistory {
  id           String    @id @default(uuid()) @db.Uuid
  employeeId   String    @db.Uuid
  supervisorId String?   @db.Uuid
  startedAt    DateTime
  endedAt      DateTime?
  reason       String?   @db.Text
  createdAt    DateTime  @default(now())

  employee   Employee  @relation(fields: [employeeId], references: [id])
  supervisor Employee? @relation("SupervisorHistoryTarget", fields: [supervisorId], references: [id])

  @@index([employeeId])
  @@index([supervisorId])
  @@index([startedAt])
  @@map("employee_supervisor_history")
}

// =============================================================================
// EmployeeProgress (Progression tracking)
// =============================================================================

model EmployeeProgress {
  id          String       @id @default(uuid()) @db.Uuid
  employeeId  String       @db.Uuid
  type        ProgressType
  points      Int
  description String?      @db.Text
  period      String?      @db.VarChar(20)
  createdAt   DateTime     @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([type])
  @@index([period])
  @@map("employee_progress")
}

// =============================================================================
// UserAccount
// =============================================================================

model UserAccount {
  id                 String        @id @default(uuid()) @db.Uuid
  employeeId         String        @unique @db.Uuid
  email              String        @unique @db.VarChar(255)
  passwordHash       String        @db.VarChar(255)
  status             AccountStatus @default(ACTIVE)
  mustChangePassword Boolean       @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  employee            Employee             @relation(fields: [employeeId], references: [id])
  passwordResetTokens PasswordResetToken[]
  auditEvents         AuditEvent[]

  @@map("user_account")
}

// =============================================================================
// PasswordResetToken
// =============================================================================

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_token")
}

// =============================================================================
// ProductCategory
// =============================================================================

model ProductCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("product_category")
}

// =============================================================================
// Product
// =============================================================================

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  price       Decimal  @db.Decimal(12, 2)
  categoryId  String   @db.Uuid
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category  ProductCategory @relation(fields: [categoryId], references: [id])
  saleItems SaleItem[]

  @@index([categoryId])
  @@index([isActive])
  @@map("product")
}

// =============================================================================
// Sale
// =============================================================================

model Sale {
  id                       String     @id @default(uuid()) @db.Uuid
  saleNumber               Int        @unique @default(autoincrement())
  employeeId               String     @db.Uuid
  saleDate                 DateTime   @db.Date
  status                   SaleStatus @default(DRAFT)
  totalAmount              Decimal    @db.Decimal(14, 2)
  approvedAt               DateTime?
  buyerName                String?    @db.VarChar(200)
  rejectionReason          String?    @db.Text
  notes                    String?    @db.Text
  visitId                  String?    @unique @db.Uuid
  clientId                 String?    @db.Uuid
  paymentMethod            String?    @db.VarChar(50)
  paymentStatus            String?    @db.VarChar(30)
  installments             Int?
  externalPaymentReference String?    @db.VarChar(150)
  cardBrand                String?    @db.VarChar(40)
  cardLast4                String?    @db.VarChar(4)
  discount                 Decimal?   @db.Decimal(14, 2)
  discountReason           String?    @db.VarChar(100)
  clientDocumentType       String?    @db.VarChar(30)
  clientDocumentNumber     String?    @db.VarChar(50)
  clientPhone              String?    @db.VarChar(50)
  clientEmail              String?    @db.VarChar(255)
  deliveryAddress          String?    @db.Text
  deliveryStatus           String?    @db.VarChar(30)
  deliveryEstimatedDate    DateTime?  @db.Date
  invoiceStatus            String?    @db.VarChar(30)
  externalInvoiceReference String?    @db.VarChar(150)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  employee          Employee          @relation(fields: [employeeId], references: [id])
  visit             Visit?            @relation(fields: [visitId], references: [id])
  client            Client?           @relation("SaleBuyer", fields: [clientId], references: [id])
  referredClients   Client[]          @relation("ClientReferredBy")
  items             SaleItem[]
  commissionEntries CommissionEntry[]
  referralContacts  ReferralContact[]

  @@index([employeeId])
  @@index([status])
  @@index([saleDate])
  @@index([clientId])
  @@index([paymentStatus])
  @@index([deliveryStatus])
  @@index([invoiceStatus])
  @@map("sale")
}

// =============================================================================
// SaleItem
// =============================================================================

model SaleItem {
  id        String   @id @default(uuid()) @db.Uuid
  saleId    String   @db.Uuid
  productId String   @db.Uuid
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  subtotal  Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_item")
}

// =============================================================================
// CommissionRule
// =============================================================================

model CommissionRule {
  id            String    @id @default(uuid()) @db.Uuid
  levelId       Int
  percentage    Decimal   @db.Decimal(5, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  level   Level             @relation(fields: [levelId], references: [id])
  entries CommissionEntry[]

  @@unique([levelId, effectiveFrom])
  @@index([levelId])
  @@index([effectiveFrom, effectiveTo])
  @@map("commission_rule")
}

// =============================================================================
// CommissionEntry
// =============================================================================

model CommissionEntry {
  id           String         @id @default(uuid()) @db.Uuid
  saleId       String         @db.Uuid
  employeeId   String         @db.Uuid
  ruleId       String         @db.Uuid
  parentId     String?        @db.Uuid
  type         CommissionType
  percentage   Decimal        @db.Decimal(5, 2)
  baseAmount   Decimal        @db.Decimal(14, 2)
  amount       Decimal        @db.Decimal(14, 2)
  saleDate     DateTime       @db.Date
  calculatedAt DateTime       @default(now())
  createdAt    DateTime       @default(now())

  sale     Sale              @relation(fields: [saleId], references: [id], onDelete: Restrict)
  employee Employee          @relation(fields: [employeeId], references: [id])
  rule     CommissionRule    @relation(fields: [ruleId], references: [id])
  parent   CommissionEntry?  @relation("CommissionEntryParent", fields: [parentId], references: [id])
  children CommissionEntry[] @relation("CommissionEntryParent")

  @@index([saleId])
  @@index([employeeId])
  @@index([ruleId])
  @@index([parentId])
  @@index([type])
  @@index([calculatedAt])
  @@map("commission_entry")
}

// =============================================================================
// AuditEvent
// =============================================================================

model AuditEvent {
  id            String      @id @default(uuid()) @db.Uuid
  actorId       String?     @db.Uuid
  actorEmail    String?     @db.VarChar(255)
  action        AuditAction
  resourceType  String      @db.VarChar(100)
  resourceId    String?     @db.Uuid
  result        AuditResult
  correlationId String?     @db.Uuid
  metadata      Json?
  createdAt     DateTime    @default(now())

  actor UserAccount? @relation(fields: [actorId], references: [id])
  // audit_event es append-only conceptual; la restricción de UPDATE/DELETE
  // se implementa en Application/Infrastructure, no en el schema Prisma.

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([action])
  @@index([correlationId])
  @@index([createdAt])
  @@map("audit_event")
}

// =============================================================================
// TrainingCategory
// =============================================================================

model TrainingCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses TrainingCourse[]

  @@map("training_category")
}

// =============================================================================
// TrainingCourse
// =============================================================================

model TrainingCourse {
  id          String        @id @default(uuid()) @db.Uuid
  categoryId  String        @db.Uuid
  name        String        @db.VarChar(200)
  description String?       @db.Text
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category TrainingCategory @relation(fields: [categoryId], references: [id])
  modules  TrainingModule[]

  @@index([categoryId])
  @@index([status])
  @@map("training_course")
}

// =============================================================================
// TrainingModule
// =============================================================================

model TrainingModule {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  name        String   @db.VarChar(200)
  description String?  @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course    TrainingCourse     @relation(fields: [courseId], references: [id])
  materials TrainingMaterial[]

  @@index([courseId])
  @@map("training_module")
}

// =============================================================================
// TrainingMaterial
// =============================================================================

model TrainingMaterial {
  id          String        @id @default(uuid()) @db.Uuid
  moduleId    String        @db.Uuid
  name        String        @db.VarChar(200)
  description String?       @db.Text
  type        ContentType
  url         String?       @db.VarChar(500)
  levelId     Int?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  module TrainingModule @relation(fields: [moduleId], references: [id])
  level  Level?         @relation(fields: [levelId], references: [id])

  @@index([moduleId])
  @@index([levelId])
  @@index([status])
  @@map("training_material")
}

// =============================================================================
// MonthlyTarget
// =============================================================================

model MonthlyTarget {
  id          Int      @id @default(autoincrement())
  levelId     Int
  targetSales Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  level Level @relation(fields: [levelId], references: [id])

  @@unique([levelId])
  @@map("monthly_target")
}

// =============================================================================
// VisitStatus (Phase 10)
// =============================================================================

enum VisitStatus {
  ASSIGNED
  COMPLETED
  NO_SALE
  CANCELLED

  @@map("visit_status")
}

// =============================================================================
// Client (Phase 10)
// =============================================================================

model Client {
  id               String   @id @default(uuid()) @db.Uuid
  clientNumber     Int      @unique @default(autoincrement())
  name             String   @db.VarChar(200)
  documentNumber   String?  @db.VarChar(50)
  phone            String?  @db.VarChar(50)
  email            String?  @db.VarChar(255)
  address          String   @db.Text
  street           String?  @db.VarChar(200)
  streetNumber     String?  @db.VarChar(20)
  floor            String?  @db.VarChar(20)
  apartment        String?  @db.VarChar(20)
  city             String?  @db.VarChar(100)
  province         String?  @db.VarChar(100)
  postalCode       String?  @db.VarChar(20)
  addressNotes     String?  @db.Text
  referredBySaleId String?  @db.Uuid
  ownerEmployeeId  String   @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  referredBySale Sale?    @relation("ClientReferredBy", fields: [referredBySaleId], references: [id])
  ownerEmployee  Employee @relation("ClientOwner", fields: [ownerEmployeeId], references: [id])
  salesAsBuyer   Sale[]   @relation("SaleBuyer")
  visits         Visit[]

  @@index([ownerEmployeeId])
  @@index([referredBySaleId])
  @@index([documentNumber])
  @@map("client")
}

// =============================================================================
// Visit (Phase 10)
// =============================================================================

model Visit {
  id            String      @id @default(uuid()) @db.Uuid
  visitNumber   Int         @unique @default(autoincrement())
  sellerId      String      @db.Uuid
  clientId      String      @db.Uuid
  assignedById  String      @db.Uuid
  scheduledDate DateTime    @db.Date
  completedDate DateTime?
  status        VisitStatus @default(ASSIGNED)
  notes         String?     @db.Text
  visitStreet           String? @db.VarChar(200)
  visitStreetNumber     String? @db.VarChar(20)
  visitFloor            String? @db.VarChar(20)
  visitApartment        String? @db.VarChar(20)
  visitCity             String? @db.VarChar(100)
  visitProvince         String? @db.VarChar(100)
  visitPostalCode       String? @db.VarChar(20)
  visitAddressNotes     String? @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  seller     Employee @relation("VisitSeller", fields: [sellerId], references: [id])
  client     Client   @relation(fields: [clientId], references: [id])
  assignedBy Employee @relation("VisitAssignedBy", fields: [assignedById], references: [id])
  sale       Sale?

  @@index([sellerId])
  @@index([clientId])
  @@index([assignedById])
  @@index([status])
  @@index([scheduledDate])
  @@map("visit")
}

// =============================================================================
// ReferralContact (Phase 10)
// =============================================================================

model ReferralContact {
  id           String   @id @default(uuid()) @db.Uuid
  saleId       String   @db.Uuid
  clientName   String   @db.VarChar(200)
  phone        String   @db.VarChar(50)
  email        String?  @db.VarChar(255)
  street       String?  @db.VarChar(200)
  streetNumber String?  @db.VarChar(20)
  floor        String?  @db.VarChar(20)
  apartment    String?  @db.VarChar(20)
  city         String?  @db.VarChar(100)
  province     String?  @db.VarChar(100)
  postalCode   String?  @db.VarChar(20)
  addressNotes String?  @db.Text
  createdAt    DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("referral_contact")
}
